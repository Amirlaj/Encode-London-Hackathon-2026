# Copy this file to .env. Never put your Gemini key in the iOS app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
# Generate with: openssl rand -hex 32
# Enter this same token in Replay > Settings on your iPhone.
APP_TOKEN=
HOST=0.0.0.0
PORT=8787
# Local uploads and reports. Use a persistent disk when hosting.
DATA_DIR=./server/data

